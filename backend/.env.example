# Supabase/Postgres connection options
# Prefer DATABASE_POOL_URL for Supabase pooler (transaction mode).
# Fall back to DATABASE_URL for direct connections.
DATABASE_POOL_URL=
DATABASE_URL=

# Local/default connection settings
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=gym_manager

# SSL control for Supabase
PGSSLMODE=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Pool configuration (production tuning)
# PGPOOL_MAX=10                  # Max concurrent clients (Supabase free: ≤15)
# PGPOOL_CONNECTION_TIMEOUT=10000 # Milliseconds to wait for a client
# PGPOOL_IDLE_TIMEOUT=30000      # Milliseconds before closing idle clients

# Set both to disable SSL only for local/self-signed environments
# PGSSLMODE=disable
# DATABASE_SSL=false
